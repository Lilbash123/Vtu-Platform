# ── Application ───────────────────────────────────────────
# Server-only. Used to build the Flutterwave redirect callback URL —
# deliberately never accepted from the client (see app/api/wallet/fund/route.ts).
# No trailing slash. Use your real production domain once deployed.
APP_BASE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server-only — never expose to the client

# ── Flutterwave (test mode keys for development) ─────────────
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your-own-random-string  # set the SAME value in your Flutterwave dashboard webhook config

# ── VTpass ────────────────────────────────────────────────
VTPASS_ENV=sandbox                                    # 'sandbox' or 'live'
VTPASS_API_KEY=your-vtpass-sandbox-api-key
VTPASS_SECRET_KEY=your-vtpass-sandbox-secret-key
VTPASS_PUBLIC_KEY=your-vtpass-sandbox-public-key
VTPASS_WEBHOOK_SECRET=your-own-random-string          # confirm VTpass's actual webhook auth scheme for your account

# ── Rate limiting (Upstash Redis — free tier is enough for dev) ─
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Cron ──────────────────────────────────────────────────
CRON_SECRET=a-long-random-string                      # Vercel Cron sends this as "Authorization: Bearer $CRON_SECRET" automatically
